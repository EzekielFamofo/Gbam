{
  "name": "Gbam/main",
  "version": "1.0.0",
  "workspaces": ["packages/*"],
  "private": true,
  "scripts": {
    "dev:web": "bun run web dev",
    "dev:cli": " bun run --watch packages/cli/src/index.tsx",
    "dev:server": " bun run --hot packages/server/src/index.ts",
    "build:cli": "bun run --filter gbam-dev build",
    "link:cli": "bun run build:cli && cd packages/cli && bun link",
    "typecheck": "bun run --filter '*' typecheck"
  },
  "dependencies": {
    "@ai-sdk/provider-utils": "^5.0.10",
    "@sentry/bun": "^10.66.0",
    "@sentry/hono": "^10.66.0",
    "dotenv": "^17.4.2",
    "hono": "^4.12.30",
    "react": "19.2.7"
  },
  "overrides": {
    "react": "19.2.7"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "bun-types": "^1.3.14",
    "typescript": "^7.0.2"
  }
}