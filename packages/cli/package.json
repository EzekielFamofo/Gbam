  },
  "dependencies": {
    "@ai-sdk/react": "^4.0.27",
    "@nightcode/shared": "workspace:*",
    "@opentui/core": "^0.4.2",
    "@opentui/react": "^0.4.2",
    "ai": "^7.0.26",
    "date-fns": "^4.4.0",
    "hono": "^4.12.27",
    "open": "^11.0.0",
    "opentui-spinner": "^0.0.7",
    "pretty-ms": "^9.3.0",
    "react": "^19.2.6",
