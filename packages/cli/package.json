{
  "name": "gbam-dev",
  "version": "1.0.0",
  "description": "Gbam CLI",
  "type": "module",
  "license": "UNLICENSED",
  "bin": {
    "gbam": "bin/gbam"
  },
  "files": [
    "bin",
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "dev": "bun run --watch src/index.tsx",
    "build": "bun build src/index.tsx --outfile dist/index.js --target bun --bundle --minify --external \"@opentui/core*\"",
    "prepublishOnly": "bun run build"
  },
  "dependencies": {
    "@opentui/core": "^0.4.2"
  },
  "devDependencies": {
    "@gbam/shared": "workspace:*",
    "@gbam/server": "workspace:*",
    "@types/bun": "latest",
    "@types/node": "latest",
    "@types/react": "^19.2.17",
    "@ai-sdk/react": "^4.0.27",
    "@opentui/react": "^0.4.2",
    "ai": "^7.0.26",
    "date-fns": "^4.4.0",
    "hono": "^4.12.27",
    "open": "^11.0.0",
    "opentui-spinner": "^0.0.7",
    "pretty-ms": "^9.3.0",
    "react": "^19.2.6",
    "react-router": "^8.1.0",
    "zod": "^4.4.3"
  }
}