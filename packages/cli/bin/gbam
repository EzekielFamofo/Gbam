#!/usr/bin/env bun
import path from "path";
import fs from "fs";

const localEnvPath = path.resolve(import.meta.dirname, "../../../.env");
if (fs.existsSync(localEnvPath)) {
    try {
        const { default: dotenv } = await import("dotenv");
        dotenv.config({ path: localEnvPath, quiet: true });
    } catch {
    }
}

// 2. Locate the compiled production bundle and the raw source file
const distPath = path.resolve(import.meta.dirname, "../dist/index.js");
const srcPath = path.resolve(import.meta.dirname, "../src/index.tsx");

// 3. Smart routing: Import dist if compiled, otherwise fallback to local src
if (fs.existsSync(distPath)) {
    await import(distPath);
} else if (fs.existsSync(srcPath)) {
    await import(srcPath);
} else {
    console.error("🚨 Error: Could not find CLI entrypoint (dist/index.js or src/index.tsx)");
    process.exit(1);
}